{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "enkot/inertify-form",
    "description": "Headless form tooling for Laravel + Inertia + Vue",
    "keywords": [
        "laravel",
        "enkot",
        "inertify-form"
    ],
    "homepage": "https://github.com/enkot/inertify-form",
    "license": "MIT",
    "authors": [
        {
            "name": "Enkot",
            "email": "taras.batenkov@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-dom": "*",
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "inertiajs/inertia-laravel": "^3.3"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "laravel/pao": "^1.0",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Inertify\\Form\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Inertify\\Form\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "vendor/bin/pint"
        ],
        "lint:check": [
            "vendor/bin/pint --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "test:types": [
            "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "suggest": {
        "league/flysystem-aws-s3-v3": "Enable S3-compatible direct and multipart uploads.",
        "spatie/laravel-medialibrary": "Synchronize submitted uploads with Media Library collections."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Inertify\\Form\\FormServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
