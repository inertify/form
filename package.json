{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@inertify/form-vue",
  "version": "0.1.0",
  "description": "Headless Vue composables and renderless components for inertify/form.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "require": "./dist/components.cjs"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js",
      "require": "./dist/composables.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/package-smoke.mjs",
    "workbench:build": "vite build",
    "workbench:dev": "vite"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^3.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.11.2",
    "laravel-vite-plugin": "^3.2.0",
    "shadcn-vue": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
